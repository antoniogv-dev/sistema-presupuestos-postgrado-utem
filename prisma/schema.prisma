generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum ProgramType {
  DOCTORADO
  MAGISTER_ACADEMICO
  MAGISTER_PROFESIONAL
  OTRO
}

enum ProgramStatus {
  ACTIVO
  INACTIVO
  EN_DISENO
}

enum BudgetStatus {
  BORRADOR
  EN_REVISION
  OBSERVADO
  APROBADO
  REEMPLAZADO
}

enum ApprovalDecision {
  PENDIENTE
  APROBADO
  OBSERVADO
  RECHAZADO
}

enum CostType {
  PROPIO_COHORTE
  COMPARTIDO
}

enum TuitionSource {
  PROPIO
  PLANTILLA_DOCTORADO
}

enum AccessLevel {
  GESTOR
  VISTO_BUENO
  APROBADOR
}

enum WorkflowStage {
  GESTION
  VISTO_BUENO
  APROBACION
  FINALIZADO
}

enum ApprovalLevel {
  VISTO_BUENO
  APROBACION
}

enum TemplateItemKind {
  DESCUENTO
  BECA_ARANCEL
  BECA_MANUTENCION
  COSTO
  INGRESO_EXTRAORDINARIO
}

enum ParameterScope {
  GENERAL
  DOCTORADO
  MAGISTER_ACADEMICO
  MAGISTER_PROFESIONAL
  OTRO
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  active      Boolean     @default(true)
  passwordHash String?
  passwordSalt String?
  passwordIterations Int?
  passwordUpdatedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  roles       UserRole[]
  sessions    UserSession[]
  budgets     CohortBudget[] @relation("BudgetResponsible")
  approvals   Approval[]
  auditLogs   AuditLog[]
  deletedBudgets CohortBudget[] @relation("BudgetDeletedBy")
  workflowEvents BudgetWorkflowEvent[]
}


model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  accessLevel AccessLevel
  users       UserRole[]
  @@index([accessLevel])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Program {
  id                        String        @id @default(cuid())
  code                      String        @unique
  name                      String
  type                      ProgramType
  faculty                   String
  director                  String
  officialDurationSemesters Int
  status                    ProgramStatus @default(ACTIVO)
  costCenter                String?
  versionLabel              String        @default("1")
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  budgets                   CohortBudget[]
  sharedCostRules           SharedCostRule[]
  annualTuitions            ProgramAnnualTuition[]
  budgetTemplates           BudgetTemplate[]
}


model ProgramAnnualTuition {
  id        String        @id @default(cuid())
  programId String
  year      Int
  amount    BigInt
  source    TuitionSource @default(PROPIO)
  templateType ProgramType?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  program   Program       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, year])
  @@index([year])
}

model BudgetTemplate {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  programType ProgramType
  description String?
  version     Int                @default(1)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  programId   String?
  program     Program?           @relation(fields: [programId], references: [id], onDelete: Cascade)
  items       BudgetTemplateItem[]
  budgets     CohortBudget[]

  @@index([programType, active])
  @@index([programId])
}

model BudgetTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  itemKey    String
  kind       TemplateItemKind
  name       String
  active     Boolean          @default(true)
  position   Int              @default(0)
  config     Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  template   BudgetTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemKey])
  @@index([templateId, position])
}

model CohortBudget {
  id                         String        @id @default(cuid())
  programId                  String
  cohortName                 String
  startYear                  Int
  startSemester              Int
  durationSemesters          Int
  initialStudents            Int
  status                     BudgetStatus  @default(BORRADOR)
  workflowStage              WorkflowStage @default(GESTION)
  facultyOverheadRate        Decimal
  enrollmentRecognitionRate Decimal
  programVersionLabel        String        @default("1")
  scholarshipsEnabled        Boolean       @default(true)
  authorizedInitialCarryover BigInt        @default(0)
  includeAuthorizedCarryover Boolean        @default(true)
  normalizeSharedCosts       Boolean        @default(true)
  alertPotentialDuplicates   Boolean        @default(true)
  appliedTemplateId          String?
  appliedTemplateVersion     Int?
  notes                      String?
  responsibleId              String
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  deletedAt                  DateTime?
  deletedById                String?
  program                    Program       @relation(fields: [programId], references: [id])
  appliedTemplate            BudgetTemplate? @relation(fields: [appliedTemplateId], references: [id], onDelete: SetNull)
  responsible                User          @relation("BudgetResponsible", fields: [responsibleId], references: [id])
  deletedBy                   User?         @relation("BudgetDeletedBy", fields: [deletedById], references: [id])
  versions                   BudgetVersion[]
  semesterPeriods            SemesterPeriod[]
  studentGroups              StudentGroup[]
  discounts                  CohortDiscount[]
  scholarships               InternalScholarship[]
  externalIncome             ExternalIncome[]
  items                      BudgetItem[]
  annualFlows                AnnualFinancialFlow[]
  annualOverrides            BudgetAnnualOverride[]
  approvals                  Approval[]
  auditLogs                  AuditLog[]
  workflowEvents             BudgetWorkflowEvent[]

  @@index([programId, cohortName])
  @@index([programId, startYear, startSemester])
  @@index([deletedAt])
  @@index([appliedTemplateId])
}

model BudgetVersion {
  id         String       @id @default(cuid())
  budgetId   String
  number     Int
  status     BudgetStatus
  snapshot   Json
  changeNote String?
  createdAt  DateTime     @default(now())
  budget     CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  approvals  Approval[]
  auditLogs  AuditLog[]
  @@unique([budgetId, number])
}

model SemesterPeriod {
  id         String       @id @default(cuid())
  budgetId   String
  year       Int
  semester   Int
  position   Int
  budget     CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parameters SemesterParameters?
  @@unique([budgetId, year, semester])
}

model SemesterParameters {
  id                                String         @id @default(cuid())
  periodId                          String         @unique
  activeStudents                    Int
  graduatingStudents                Int            @default(0)
  directTeachingHours               Decimal
  replacementTeachingHours          Decimal
  electiveSubjects                  Int            @default(0)
  electiveSections                  Int            @default(0)
  specializedCourses               Int            @default(0)
  specializedSections              Int            @default(0)
  internalTuitionScholarshipStudents Int           @default(0)
  internalTuitionScholarshipCoverage Decimal       @default(1)
  maintenanceScholarshipStudents    Int            @default(0)
  maintenanceScholarshipMonths      Int            @default(0)
  notes                              String?
  period                             SemesterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model InstitutionalParameter {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  unit        String
  annual      Boolean           @default(false)
  editablePerBudget Boolean     @default(false)
  values      AnnualParameter[]
}

model AnnualParameter {
  id          String                 @id @default(cuid())
  parameterId String
  year        Int?
  scope       ParameterScope         @default(GENERAL)
  amount      Decimal
  validFrom   DateTime?
  validTo     DateTime?
  parameter   InstitutionalParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  @@unique([parameterId, year, scope])
  @@index([scope, year])
}

model StudentGroup {
  id          String       @id @default(cuid())
  budgetId    String
  name        String
  students    Int
  description String?
  budget      CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model DiscountType {
  id          String           @id @default(cuid())
  name        String           @unique
  active      Boolean          @default(true)
  discounts   CohortDiscount[]
}

model CohortDiscount {
  id            String       @id @default(cuid())
  budgetId      String
  discountTypeId String
  name          String
  percentage    Decimal
  students      Int
  startYear     Int
  startSemester Int
  endYear       Int
  endSemester   Int
  note          String?
  originTemplateItemKey String?
  budget        CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  discountType  DiscountType @relation(fields: [discountTypeId], references: [id])
}

model InternalScholarship {
  id            String       @id @default(cuid())
  budgetId      String
  type          String
  students      Int
  coverage      Decimal?
  monthlyAmount BigInt?
  months        Int?
  startYear     Int
  startSemester Int
  endYear       Int
  endSemester   Int
  budget        CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model ExternalIncome {
  id               String       @id @default(cuid())
  budgetId         String
  type             String
  description      String
  year             Int
  semester         Int
  students         Int
  amountPerStudent BigInt
  source           String
  note             String?
  originTemplateItemKey String?
  budget           CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

model BudgetItem {
  id          String       @id @default(cuid())
  budgetId    String
  name        String
  description String
  category    String
  year        Int
  semester    Int?
  amount      BigInt
  costType    CostType
  periodicity String
  note        String?
  originTemplateItemKey String?
  budget      CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  @@index([budgetId, year, category])
}

model SharedCostRule {
  id          String   @id @default(cuid())
  programId   String
  category    String
  method      String
  active      Boolean  @default(true)
  description String?
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@unique([programId, category])
}


model BudgetAnnualOverride {
  id                               String       @id @default(cuid())
  budgetId                         String
  year                             Int
  directTeachingHourValue          Decimal
  annualEnrollmentFee              BigInt
  annualTuition                    BigInt       @default(0)
  thesisGuidancePerGraduatingStudent BigInt
  annualDirection                  BigInt
  directionProrated                Boolean      @default(false)
  directionAllocationRate          Decimal      @default(1)
  annualAssistance                 BigInt
  assistanceProrated               Boolean      @default(false)
  assistanceAllocationRate         Decimal      @default(1)
  centralOverheadRate              Decimal      @default(0)
  facultyOverheadRate              Decimal      @default(0)
  budget                           CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, year])
  @@index([year])
}

model AnnualFinancialFlow {
  id                        String       @id @default(cuid())
  budgetId                  String
  year                      Int
  annualTuition             BigInt       @default(0)
  grossTuition              BigInt
  discounts                 BigInt
  tuitionScholarships       BigInt
  badDebt                   BigInt
  netTuitionIncome          BigInt
  enrollmentIncome          BigInt
  externalIncome            BigInt
  totalIncome               BigInt
  equivalentEnrollments     Decimal      @default(0)
  roundedEquivalentStudents Int          @default(0)
  graduatingStudents        Int          @default(0)
  thesisGuidanceCost        BigInt       @default(0)
  centralOverhead           BigInt       @default(0)
  facultyOverhead           BigInt       @default(0)
  totalExpenses             BigInt
  netFlow                   BigInt
  startingCarryover         BigInt
  accumulatedFlow           BigInt
  operatingMargin           Decimal?
  calculatedAt              DateTime     @default(now())
  budget                    CohortBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  @@unique([budgetId, year])
  @@index([year])
}

model Approval {
  id         String           @id @default(cuid())
  budgetId   String
  versionId  String?
  userId     String
  decision   ApprovalDecision @default(PENDIENTE)
  level      ApprovalLevel
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime         @default(now())
  budget     CohortBudget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  version    BudgetVersion?   @relation(fields: [versionId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
}


model BudgetWorkflowEvent {
  id        String        @id @default(cuid())
  budgetId  String
  userId    String
  role      AccessLevel
  action    String
  fromStage WorkflowStage
  toStage   WorkflowStage
  comment   String?
  createdAt DateTime      @default(now())
  budget    CohortBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([budgetId, createdAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  userId      String
  budgetId    String?
  versionId   String?
  entity      String
  entityId    String
  field       String?
  previousValue Json?
  newValue    Json?
  action      String
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id])
  budget      CohortBudget?  @relation(fields: [budgetId], references: [id])
  version     BudgetVersion? @relation(fields: [versionId], references: [id])
  @@index([entity, entityId, createdAt])
}
