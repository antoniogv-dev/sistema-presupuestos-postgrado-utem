{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sistema-presupuestos-postgrado-utem",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postgrado-presupuestos-prod",
      "database_id": "d5d73814-ecd9-45f3-99d0-ddcc3c9a7f42",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Sistema de Presupuestos de Postgrado UTEM",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://REEMPLAZAR_EQUIPO.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "REEMPLAZAR_AUD_DE_ACCESS",
    "BOOTSTRAP_ADMIN_EMAIL": "manuel.gutierrez@utem.cl"
  },
  "observability": {
    "enabled": true
  }
}
